generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════
// PHASE 1 — TRANSPORTATION CORE DATA MODEL
// Lead → Account → Opportunity → Submission → Quote → Policy → Renewal
// ═══════════════════════════════════════════════════════════════════

enum LeadStatus {
  pending
  scheduled
  calling
  called
  qualified
  converted        // promoted to Account + Opportunity
  nurture
  compliance_hold  // blocked by compliance engine
  rejected_timezone
  closed
}

enum ComplianceStatus {
  unchecked
  clear
  hold       // missing consent / outside window — recheck later
  blocked    // DNC / unlicensed state — do not contact
}

enum OpportunityStage {
  NEW
  QUALIFIED
  RISK_PROFILED
  SUBMITTED
  QUOTED
  PROPOSAL
  BIND_PENDING
  BOUND
  LOST
  NURTURE
}

enum SubmissionStatus {
  DRAFT
  READY
  SUBMITTED
  UNDER_REVIEW
  QUOTED
  DECLINED
  WITHDRAWN
}

enum QuoteStatus {
  RECEIVED
  PRESENTED
  ACCEPTED
  DECLINED
  EXPIRED
}

enum PolicyStatus {
  ACTIVE
  PENDING_CANCEL
  CANCELLED
  EXPIRED
  NON_RENEWED
}

enum RenewalStage {
  NOT_STARTED
  CONTACTED
  RE_MARKETING
  QUOTED
  PROPOSAL
  BOUND
  LOST
}

// ─── LEAD (existing acquisition entity — unchanged shape, new links) ───
model Lead {
  id               String           @id @default(uuid())
  name             String
  phone            String
  email            String?
  company          String?
  title            String?
  state            String
  city             String?
  county           String?
  insuranceType    String           @default("commercial_auto") @map("insurance_type")
  source           String
  status           String           @default("pending")
  qualified        Boolean          @default(false)
  transcript       String?          @db.Text
  vapiCallId       String?          @map("vapi_call_id")
  vapiCost         Decimal?         @map("vapi_cost") @db.Decimal(10, 4)
  dotNumber        String?          @map("dot_number")
  mcNumber         String?          @map("mc_number")
  vehicleCount     Int?             @map("vehicle_count")
  driverCount      Int?             @map("driver_count")
  authorityStatus  String?          @map("authority_status")
  xDate            DateTime?        @map("x_date")
  currentCarrier   String?          @map("current_carrier")
  workersCompMod   Decimal?         @map("workers_comp_mod") @db.Decimal(4, 2)
  industry         String?
  revenue          Int?
  employeeCount    Int?             @map("employee_count")
  naicsCode        String?          @map("naics_code")
  scheduledCallAt  DateTime?        @map("scheduled_call_at")
  calledAt         DateTime?        @map("called_at")
  qualifiedAt      DateTime?        @map("qualified_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  // Phase 1 additions
  complianceStatus String           @default("unchecked") @map("compliance_status")
  complianceNotes  String?          @map("compliance_notes") @db.Text
  accountId        String?          @map("account_id")

  // Phase 2 — transportation intelligence
  riskScore        Int?             @map("risk_score")
  opportunityScore Int?             @map("opportunity_score")
  scoreBand        String?          @map("score_band")       // HOT / GOOD / NURTURE / DONT_WASTE_TIME
  xdateTier        String?          @map("xdate_tier")       // STRIKE_ZONE / ACTIVE / EARLY / NURTURE ...
  operatingRadius  String?          @map("operating_radius") // local / regional / interstate
  hazmat           Boolean?
  interstate       Boolean?

  // Phase 3 — sales engine
  callAttempts     Int              @default(0) @map("call_attempts")
  lastDisposition  String?          @map("last_disposition") // booked / callback / no_answer / dnc ...

  // Phase 1 tenancy — nullable clientId keeps legacy null-client behavior
  clientId         String?          @map("client_id")

  account      Account?       @relation(fields: [accountId], references: [id], onDelete: SetNull)
  client       Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  callLogs     CallLog[]
  costs        Cost[]
  opportunities Opportunity[]
  tasks        Task[]

  @@index([clientId, status])
  @@index([state, status])
  @@index([source, createdAt])
  @@index([scheduledCallAt])
  @@index([status, qualified])
  @@index([accountId])
  @@index([scoreBand, opportunityScore])
  @@index([xdateTier])
  @@map("leads")
}

model CallLog {
  id           String   @id @default(uuid())
  leadId       String   @map("lead_id")
  callId       String   @map("call_id")
  status       String
  duration     Int?
  cost         Decimal? @db.Decimal(10, 4)
  transcript   String?  @db.Text
  summary      String?  @db.Text
  qualified    Boolean  @default(false)
  disposition  String?  // Phase 3 — booked / callback / interested / not_interested / dnc / no_answer
  recordingUrl String?  @map("recording_url")
  createdAt    DateTime @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([callId])
  @@map("call_logs")
}

model Cost {
  id          String   @id @default(uuid())
  leadId      String?  @map("lead_id")
  type        String
  amount      Decimal  @db.Decimal(10, 4)
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  // Phase 1 tenancy
  clientId    String?  @map("client_id")

  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)
  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([clientId, createdAt])
  @@map("costs")
}

model DailyStat {
  id            String   @id @default(uuid())
  date          DateTime @unique
  leadsIngested Int      @default(0) @map("leads_ingested")
  callsMade     Int      @default(0) @map("calls_made")
  qualified     Int      @default(0)
  smsSent       Int      @default(0) @map("sms_sent")
  emailsSent    Int      @default(0) @map("emails_sent")
  totalCost     Decimal  @default(0) @map("total_cost") @db.Decimal(10, 4)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("daily_stats")
}

// ─── ACCOUNT (the transportation business) ───
model Account {
  id              String   @id @default(uuid())
  company         String
  dba             String?
  dotNumber       String?  @map("dot_number")
  mcNumber        String?  @map("mc_number")
  authorityStatus String?  @map("authority_status")

  // Location
  state           String
  city            String?
  address         String?
  county          String?

  // Contact
  phone           String?
  email           String?
  website         String?
  contactName     String?  @map("contact_name")
  contactTitle    String?  @map("contact_title")

  // Transportation profile
  vehicleCount    Int?     @map("vehicle_count")
  driverCount     Int?     @map("driver_count")
  operatingRadius String?  @map("operating_radius")   // local / regional / long_haul
  commodities     String?  // free text or comma list; hazmat flagged in metadata
  hazmat          Boolean  @default(false)
  naicsCode       String?  @map("naics_code")
  industry        String?
  revenue         Int?
  employeeCount   Int?     @map("employee_count")

  // Scores (populated by Phase 2 engines)
  riskScore        Int?    @map("risk_score")
  opportunityScore Int?    @map("opportunity_score")

  notes     String?   @db.Text
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // Phase 1 tenancy
  clientId  String?  @map("client_id")

  client        Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  leads         Lead[]
  opportunities Opportunity[]
  policies      Policy[]
  renewals      Renewal[]
  tasks         Task[]

  @@index([clientId])
  @@index([state])
  @@index([dotNumber])
  @@index([mcNumber])
  @@map("accounts")
}

// ─── OPPORTUNITY (an insurance sales opportunity on an Account) ───
model Opportunity {
  id              String   @id @default(uuid())
  accountId       String   @map("account_id")
  leadId          String?  @map("lead_id")

  stage           OpportunityStage @default(NEW)
  lineOfBusiness  String   @default("commercial_auto") @map("line_of_business")

  xDate           DateTime? @map("x_date")
  currentCarrier  String?   @map("current_carrier")
  estimatedPremium Int?     @map("estimated_premium")
  priority        String    @default("normal") // hot / high / normal / low

  riskScore        Int?    @map("risk_score")
  opportunityScore Int?    @map("opportunity_score")

  lostReason      String?  @map("lost_reason")
  closedAt        DateTime? @map("closed_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Phase 1 tenancy
  clientId        String?  @map("client_id")

  account     Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  lead        Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  client      Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  submissions Submission[]
  tasks       Task[]

  @@index([clientId, stage])
  @@index([accountId, stage])
  @@index([stage, priority])
  @@index([xDate])
  @@map("opportunities")
}

// ─── TASK (Phase 3 — Dave's to-do list, created by the engines) ───
model Task {
  id            String   @id @default(uuid())
  leadId        String?  @map("lead_id")
  opportunityId String?  @map("opportunity_id")
  accountId     String?  @map("account_id")

  type          String   // CALL_BACK / FOLLOW_UP / REVIEW / SEND_QUOTE / SERVICE
  title         String
  notes         String?  @db.Text
  dueAt         DateTime? @map("due_at")
  status        String   @default("open") // open / done / cancelled
  priority      String   @default("normal") // hot / high / normal / low

  completedAt   DateTime? @map("completed_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Phase 1 tenancy
  clientId      String?  @map("client_id")

  lead        Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  account     Account?     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  client      Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([clientId, status])
  @@index([status, dueAt])
  @@index([leadId])
  @@index([opportunityId])
  @@map("tasks")
}

// ─── SUBMISSION (a carrier-ready package for one market) ───
model Submission {
  id            String   @id @default(uuid())
  opportunityId String   @map("opportunity_id")

  carrier       String
  status        SubmissionStatus @default(DRAFT)

  // Frozen snapshot of the risk data sent to the carrier (ACORD-ish JSON)
  packageJson   Json?    @map("package_json")
  appetiteMatch Json?    @map("appetite_match") // carrier-match engine output

  submittedAt   DateTime? @map("submitted_at")
  respondedAt   DateTime? @map("responded_at")
  declinedReason String?  @map("declined_reason")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  quotes      Quote[]

  @@index([opportunityId, status])
  @@index([carrier, status])
  @@map("submissions")
}

// ─── QUOTE ───
model Quote {
  id           String   @id @default(uuid())
  submissionId String   @map("submission_id")

  carrier      String
  status       QuoteStatus @default(RECEIVED)

  premium      Decimal? @db.Decimal(12, 2)
  commissionRate Decimal? @map("commission_rate") @db.Decimal(5, 2)
  coverageJson Json?    @map("coverage_json") // limits, deductibles, endorsements

  effectiveDate  DateTime? @map("effective_date")
  expirationDate DateTime? @map("expiration_date")

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  policies   Policy[]

  @@index([submissionId])
  @@map("quotes")
}

// ─── POLICY (bound coverage) ───
model Policy {
  id            String   @id @default(uuid())
  accountId     String   @map("account_id")
  quoteId       String?  @map("quote_id")

  policyNumber  String?  @map("policy_number")
  carrier       String
  lineOfBusiness String  @default("commercial_auto") @map("line_of_business")
  status        PolicyStatus @default(ACTIVE)

  effectiveDate  DateTime @map("effective_date")
  expirationDate DateTime @map("expiration_date")
  premium        Decimal? @db.Decimal(12, 2)
  commissionRate Decimal? @map("commission_rate") @db.Decimal(5, 2)

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  quote   Quote?  @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  renewals Renewal[]

  @@index([accountId, status])
  @@index([expirationDate])
  @@map("policies")
}

// ─── RENEWAL ───
model Renewal {
  id         String   @id @default(uuid())
  policyId   String   @map("policy_id")
  accountId  String   @map("account_id")

  stage      RenewalStage @default(NOT_STARTED)
  renewalDate DateTime @map("renewal_date")

  incumbentPremium Decimal? @map("incumbent_premium") @db.Decimal(12, 2)
  targetPremium    Decimal? @map("target_premium") @db.Decimal(12, 2)
  boundPremium     Decimal? @map("bound_premium") @db.Decimal(12, 2)

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  policy  Policy  @relation(fields: [policyId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([renewalDate, stage])
  @@map("renewals")
}

// ═══════════════════════════════════════════════════════════════════
// AUDIT TRAIL — every mutation that matters, who/what/when/before/after
// ═══════════════════════════════════════════════════════════════════
model AuditLog {
  id         String   @id @default(uuid())
  actor      String   // "system", "dave", "webhook:vapi", api-key label, etc.
  action     String   // "create", "update", "delete", "stage_change", "contact_blocked"...
  entityType String   @map("entity_type") // "Lead", "Opportunity", ...
  entityId   String   @map("entity_id")
  before     Json?
  after      Json?
  metadata   Json?    // ip, userAgent, requestId
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ═══════════════════════════════════════════════════════════════════
// COMPLIANCE
// ═══════════════════════════════════════════════════════════════════
model DncEntry {
  id        String   @id @default(uuid())
  phone     String?  // E.164
  email     String?
  reason    String?
  source    String   @default("manual") // manual / call_opt_out / sms_stop / vendor
  createdAt DateTime @default(now()) @map("created_at")

  // Phase 1 tenancy
  clientId  String?  @map("client_id")

  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([phone])
  @@index([email])
  @@index([clientId, phone])
  @@index([clientId, email])
  @@map("dnc_entries")
}

model ConsentEvent {
  id          String   @id @default(uuid())
  leadId      String?  @map("lead_id")
  phone       String?
  channel     String   // call / sms / email
  consentType String   @map("consent_type") // express_written / express_verbal / implied / revoked
  granted     Boolean
  proofText   String?  @map("proof_text") @db.Text
  source      String?
  capturedAt  DateTime @default(now()) @map("captured_at")

  // Phase 1 tenancy
  clientId    String?  @map("client_id")

  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([phone, channel])
  @@index([clientId, phone])
  @@map("consent_events")
}

// ═══════════════════════════════════════════════════════════════════
// PHASE 1 TENANCY — thin clientId layer (insurance-agent clients)
// Null clientId = legacy single-agency behavior (existing env config).
// ═══════════════════════════════════════════════════════════════════
model Client {
  id                String   @id @default(uuid())
  name              String
  slug              String   @unique
  licensedStates    String[] @map("licensed_states")
  vapiAssistantId   String?  @map("vapi_assistant_id")
  vapiPhoneNumberId String?  @map("vapi_phone_number_id")
  calendlyLink      String?  @map("calendly_link")
  brevoSenderName   String?  @map("brevo_sender_name")
  brevoSenderEmail  String?  @map("brevo_sender_email")
  brandingJson      Json?    @map("branding_json")
  active            Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  leads           Lead[]
  accounts        Account[]
  opportunities   Opportunity[]
  tasks           Task[]
  costs           Cost[]
  dncEntries      DncEntry[]
  consentEvents   ConsentEvent[]
  agencyProspects AgencyProspect[]

  @@map("clients")
}

// ─── AGENCY PROSPECT (Instantly AI — acquiring insurance-agent clients,
//     NOT insurance prospects. Fed by Instantly webhooks/polling.) ───
model AgencyProspect {
  id                  String   @id @default(uuid())
  email               String   @unique
  firstName           String?  @map("first_name")
  lastName            String?  @map("last_name")
  agencyName          String?  @map("agency_name")
  phone               String?
  state               String?
  // Phase 1 string status: new / contacted / replied / qualified / booked /
  // client / unsubscribed / bounced (validated in code, not enum)
  status              String   @default("new")
  instantlyLeadId     String?  @map("instantly_lead_id")
  instantlyCampaignId String?  @map("instantly_campaign_id")
  lastEvent           String?  @map("last_event")
  notes               String?  @db.Text
  clientId            String?  @map("client_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([status, updatedAt])
  @@index([clientId])
  @@index([instantlyLeadId])
  @@map("agency_prospects")
}
