// InsureFlow AI 2.0 — Prisma schema
// Launch scope: Michigan commercial trucking (FMCSA data).
// Design notes:
// - Lead is the prospect record (pre-sale). Account/Opportunity/Policy are post-sale.
// - FMCSA fields (dotNumber, vehicleCount, xDate etc.) live directly on Lead so the
//   agent sees renewal timing + fleet size without joining.
// - CallLog stores every Vapi interaction; DailyStat rolls up for the dashboard.
// - Cost tracks every penny — "track every dollar" requirement.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id               String           @id @default(uuid())
  name             String
  phone            String?           // nullable — email-only Apollo leads have no phone
  email            String?
  company          String?
  title            String?
  state            String
  city             String?
  county           String?
  insuranceType    String           @default("commercial_auto") @map("insurance_type")
  source           String
  status           String           @default("pending")
  qualified        Boolean          @default(false)
  transcript       String?          @db.Text
  vapiCallId       String?          @map("vapi_call_id")
  vapiCost         Decimal?         @map("vapi_cost") @db.Decimal(10, 4)
  dotNumber        String?          @map("dot_number")
  mcNumber         String?          @map("mc_number")
  vehicleCount     Int?             @map("vehicle_count")
  driverCount      Int?             @map("driver_count")
  authorityStatus  String?          @map("authority_status")
  xDate            DateTime?        @map("x_date")
  currentCarrier   String?          @map("current_carrier")
  workersCompMod   Decimal?         @map("workers_comp_mod") @db.Decimal(4, 2)
  industry         String?
  revenue          Int?
  employeeCount    Int?             @map("employee_count")
  naicsCode        String?          @map("naics_code")
  scheduledCallAt  DateTime?        @map("scheduled_call_at")
  calledAt         DateTime?        @map("called_at")
  qualifiedAt      DateTime?        @map("qualified_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  // ── Life vertical (life_fe) — HasData identity ──
  occupation        String?   // niche query, e.g. "barbershop"
  occupationPlural  String?   @map("occupation_plural") // e.g. "barbershops"
  categories        String?   // comma-joined Maps categories
  placeId           String?   @unique @map("place_id")  // Google place_id — dedupe key
  vertical          String?   @default("commercial_auto") // life_fe | commercial_auto

  // ── Life vertical — Russell fact-find (captured on the call) ──
  age               Int?
  smoker            Boolean?
  medications       String?   // free-text health/meds notes
  monthlyPremium    Int?      @map("monthly_premium")  // budget they stated
  coverageAmount    Int?      @map("coverage_amount")  // face-amount goal
  quoteEmailSent    Boolean   @default(false) @map("quote_email_sent")

  // Phase 1 additions
  complianceStatus String           @default("unchecked") @map("compliance_status")
  complianceNotes  String?          @map("compliance_notes") @db.Text
  accountId        String?          @map("account_id")

  // Phase 2 — transportation intelligence
  riskScore        Int?             @map("risk_score")
  opportunityScore Int?             @map("opportunity_score")
  scoreBand        String?          @map("score_band")
  xdateTier        String?          @map("xdate_tier")
  operatingRadius  String?          @map("operating_radius")
  hazmat           Boolean?
  interstate       Boolean?

  // Phase 3 — sales engine
  callAttempts     Int              @default(0) @map("call_attempts")
  lastDisposition  String?          @map("last_disposition")

  account      Account?       @relation(fields: [accountId], references: [id], onDelete: SetNull)
  callLogs     CallLog[]
  costs        Cost[]
  opportunities Opportunity[]
  tasks        Task[]

  @@index([state, status])
  @@index([source, createdAt])
  @@index([scheduledCallAt])
  @@index([status, qualified])
  @@index([accountId])
  @@index([scoreBand, opportunityScore])
  @@index([xdateTier])
  @@index([vertical, occupation])
  @@map("leads")
}

model CallLog {
  id           String    @id @default(uuid())
  leadId       String    @map("lead_id")
  callId       String?   @map("call_id")
  status       String // initiated, ringing, in-progress, completed, failed
  duration     Int?     // seconds
  transcript   String?   @db.Text
  summary      String?   @db.Text
  outcome      String?  // qualified, callback, not_interested, no_answer
  recordingUrl String?   @map("recording_url")
  cost         Decimal?  @db.Decimal(10, 4)
  createdAt    DateTime  @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([status])
  @@map("call_logs")
}

model Account {
  id          String   @id @default(uuid())
  company     String
  contactName String?  @map("contact_name")
  phone       String?
  email       String?
  state       String
  dotNumber   String?  @map("dot_number")
  vehicleCount Int?    @map("vehicle_count")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  leads         Lead[]
  opportunities Opportunity[]
  policies      Policy[]
  renewals      Renewal[]

  @@map("accounts")
}

model Opportunity {
  id           String    @id @default(uuid())
  accountId    String    @map("account_id")
  leadId       String?   @map("lead_id")
  stage        String    @default("PROSPECTING") // PROSPECTING, QUALIFIED, QUOTED, NEGOTIATING, BOUND, LOST
  priority     String    @default("normal") // hot, high, normal, low
  xDate        DateTime? @map("x_date")
  lostReason   String?   @map("lost_reason")
  closedAt     DateTime? @map("closed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  account     Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  lead        Lead?        @relation(fields: [leadId], references: [id])
  submissions Submission[]

  @@index([stage, priority])
  @@index([xDate])
  @@map("opportunities")
}

model Submission {
  id             String    @id @default(uuid())
  opportunityId  String    @map("opportunity_id")
  carrier        String
  status         String    @default("DRAFT") // DRAFT, SUBMITTED, QUOTED, DECLINED
  declinedReason String?   @map("declined_reason")
  respondedAt    DateTime? @map("responded_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  quotes      Quote[]

  @@index([opportunityId, status])
  @@map("submissions")
}

model Quote {
  id             String    @id @default(uuid())
  submissionId   String    @map("submission_id")
  premium        Int       // annual premium in dollars
  commissionRate Decimal?  @map("commission_rate") @db.Decimal(5, 2)
  coverages      String?   @db.Text // JSON of coverage details
  effectiveDate  DateTime? @map("effective_date")
  expirationDate DateTime? @map("expiration_date")
  status         String    @default("DRAFT") // DRAFT, PRESENTED, ACCEPTED, DECLINED
  notes          String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  policies   Policy[]

  @@map("quotes")
}

model Policy {
  id             String    @id @default(uuid())
  accountId      String    @map("account_id")
  quoteId        String?   @map("quote_id")
  carrier        String
  policyNumber   String?   @map("policy_number")
  premium        Int
  status         String    @default("ACTIVE") // ACTIVE, CANCELLED, EXPIRED, NON_RENEWED
  effectiveDate  DateTime  @map("effective_date")
  expirationDate DateTime  @map("expiration_date")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  quote    Quote?    @relation(fields: [quoteId], references: [id])
  renewals Renewal[]

  @@index([status, expirationDate])
  @@map("policies")
}

model Renewal {
  id          String    @id @default(uuid())
  accountId   String    @map("account_id")
  policyId    String    @map("policy_id")
  stage       String    @default("UPCOMING") // UPCOMING, CONTACTED, QUOTED, RENEWED, LOST
  renewalDate DateTime  @map("renewal_date")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  policy  Policy  @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([stage, renewalDate])
  @@map("renewals")
}

model Task {
  id            String    @id @default(uuid())
  leadId        String?   @map("lead_id")
  opportunityId String?   @map("opportunity_id")
  title         String
  description   String?   @db.Text
  priority      String    @default("normal") // hot, high, normal, low
  status        String    @default("open") // open, done, cancelled
  dueAt         DateTime? @map("due_at")
  completedAt   DateTime? @map("completed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  lead        Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  @@index([status, priority, dueAt])
  @@map("tasks")
}

model DailyStat {
  id            String   @id @default(uuid())
  date          DateTime @unique
  leadsIngested Int      @default(0) @map("leads_ingested")
  callsMade     Int      @default(0) @map("calls_made")
  qualified     Int      @default(0)
  smsSent       Int      @default(0) @map("sms_sent")
  emailsSent    Int      @default(0) @map("emails_sent")
  totalCost     Decimal  @default(0) @map("total_cost") @db.Decimal(10, 2)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("daily_stats")
}

model Cost {
  id        String   @id @default(uuid())
  leadId    String?  @map("lead_id")
  type      String   // vapi_call, brevo_email, brevo_sms, apollo_credit, hasdata_credit
  amount    Decimal  @db.Decimal(10, 4)
  metadata  String?  @db.Text // JSON
  createdAt DateTime @default(now()) @map("created_at")

  lead Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@map("costs")
}

model DncEntry {
  id        String   @id @default(uuid())
  phone     String?
  email     String?
  reason    String?
  source    String   // admin, webhook, verbal_opt_out, brevo_unsub
  createdAt DateTime @default(now()) @map("created_at")

  @@map("dnc_entries")
}

model ConsentEvent {
  id          String   @id @default(uuid())
  leadId      String?  @map("lead_id")
  phone       String?
  channel     String   // sms, email, voice
  granted     Boolean
  consentType String?  @map("consent_type") // express_written, verbal, implied
  proofText   String?  @map("proof_text") @db.Text
  source      String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([phone])
  @@map("consent_events")
}

model AuditLog {
  id         String   @id @default(uuid())
  actor      String
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  before     String?  @db.Text // JSON
  after      String?  @db.Text // JSON
  metadata   String?  @db.Text // JSON
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
